// ============================================================================
// GroomingOS V1.0 — Prisma Schema (PostgreSQL)
// Cubre los 7 módulos: Agenda/IA, CRM Canino, Mise en Place, Tiempos en Mesa,
// Inventario/Activos, Cobro/Anti-morosidad, Inteligencia Financiera.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum Role {
  ADMIN
  GROOMER
  RECEPTION
}

enum SensitivityLevel {
  NONE
  LOW
  MEDIUM
  HIGH
}

enum RecurrenceInterval {
  DAYS_7
  DAYS_15
  DAYS_21
  DAYS_30
}

enum AppointmentSource {
  SELF_SERVICE_WEB
  RECURRING_AUTO
  MANUAL_STAFF
  WHATSAPP_REBOOK
}

enum AppointmentStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  RESCHEDULE_REQUESTED
  CHECKED_IN
  IN_PROGRESS
  DELAYED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum NotificationStage {
  T_MINUS_5_DAYS
  T_MINUS_24_HOURS
  T_MINUS_22_HOURS_LOCATION
  T_MINUS_15_MIN_DEPARTURE
  POST_SERVICE_RECEIPT
  DELAY_ALERT
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  RESPONDED
}

enum ServiceStageType {
  BATH
  DRYING
  HAIRCUT
  NAILS
  EARS
  DESHEDDING
  FINISHING
  OTHER
}

enum TimeLogStatus {
  ON_TRACK // verde, <=90%
  WARNING // amarillo, 90-100%
  DELAYED // rojo, >100%
}

enum TimeLogSource {
  VOICE
  MANUAL
  DRAG_DROP
  SYSTEM_OVERRIDE
}

enum ProductUnit {
  ML
  GRAM
  UNIT
}

enum InventoryTxType {
  CONSUMPTION
  RESTOCK
  ADJUSTMENT
  WASTE
}

enum InstrumentType {
  BLADE
  COMB_GUIDE
  SCISSORS
  RAKE
  OTHER
}

enum InstrumentStatus {
  OK
  NEEDS_SHARPENING
  NEEDS_REPLACEMENT
  RETIRED
}

enum EquipmentType {
  DRYER
  TURBINE
  CLIPPER_MACHINE
  GROOMING_TABLE
  OTHER
}

enum EquipmentStatus {
  OPERATIONAL
  NEEDS_MAINTENANCE
  OUT_OF_SERVICE
}

enum PrepItemType {
  FORMULA
  INSTRUMENT
  SAFETY_EQUIPMENT
}

enum BillingStatus {
  PAID
  PENDING_PROOF
  OVERDUE
  BLOCKED
  MANUALLY_UNBLOCKED
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  OTHER
}

enum ExpenseFrequency {
  MONTHLY
  YEARLY
  ONE_TIME
}

// ----------------------------------------------------------------------------
// MÓDULO 1+2: TUTORES, MASCOTAS, CRM Y EXPEDIENTE TÉCNICO
// ----------------------------------------------------------------------------

model Tutor {
  id                 String        @id @default(cuid())
  fullName           String
  phoneWhatsApp      String        @unique
  email              String?
  address            String?
  addressMapUrl      String?
  billingStatus      BillingStatus @default(PAID)
  antiFraudConsentAt DateTime? // aceptación de cláusula "cotización estimada"
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  pets         Pet[]
  appointments Appointment[]
  invoices     Invoice[]
  notifications NotificationLog[]

  @@index([phoneWhatsApp])
}

model Pet {
  id             String    @id @default(cuid())
  tutorId        String
  name           String
  breed          String
  sizeCategory   String? // XS, S, M, L, XL — usado para pricing/tiempos estándar
  coatType       String? // liso, rizado, doble manto, duro, etc.
  weightEstimated Decimal? @db.Decimal(5, 2)
  weightReal      Decimal? @db.Decimal(5, 2) // capturado en recepción
  birthDate      DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tutor           Tutor            @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  clinicalRecord  ClinicalRecord?
  photos          PetPhoto[]
  appointments    Appointment[]
  recurringSchedules RecurringSchedule[]

  @@index([tutorId])
}

model PetPhoto {
  id        String   @id @default(cuid())
  petId     String
  url       String
  type      String // PROFILE, BEFORE, AFTER
  takenAt   DateTime @default(now())

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId])
}

// Ficha clínica y conductual (1-1 con Pet)
model ClinicalRecord {
  id                  String           @id @default(cuid())
  petId               String           @unique
  allergies           String[]
  acousticSensitivity SensitivityLevel @default(NONE)
  reactivity          SensitivityLevel @default(NONE)
  requiresMuzzle      Boolean          @default(false)
  requiresHappyHoodie Boolean          @default(false)
  behavioralNotes     String?
  medicalNotes        String?
  updatedAt           DateTime         @updatedAt

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------------------------------
// MÓDULO 1: AGENDA INTELIGENTE
// ----------------------------------------------------------------------------

model Staff {
  id       String  @id @default(cuid())
  fullName String
  role     Role    @default(GROOMER)
  phone    String?
  active   Boolean @default(true)

  appointments Appointment[]
  timeLogs     TimeLog[]
  maintenanceLogsPerformed MaintenanceLog[]
}

// Catálogo de servicios con tiempos y precios base (por tamaño/raza vía ServicePricing)
model Service {
  id                  String   @id @default(cuid())
  name                String
  description         String?
  basePrice           Decimal  @db.Decimal(10, 2)
  standardDurationMin Int
  active              Boolean  @default(true)

  stageTemplates    ServiceStageTemplate[]
  appointments      Appointment[]
  recurringSchedules RecurringSchedule[]
  formulas          Formula[]
}

// Desglose de etapas estándar por servicio (para el semáforo de tiempos)
model ServiceStageTemplate {
  id                  String           @id @default(cuid())
  serviceId           String
  stageType           ServiceStageType
  order               Int
  standardDurationMin Int

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model RecurringSchedule {
  id              String             @id @default(cuid())
  petId           String
  serviceId       String
  interval        RecurrenceInterval
  preferredWeekday Int? // 0-6
  preferredTime   String? // "10:00"
  active          Boolean            @default(true)
  lastGeneratedAt DateTime?
  createdAt       DateTime           @default(now())

  pet          Pet           @relation(fields: [petId], references: [id], onDelete: Cascade)
  service      Service       @relation(fields: [serviceId], references: [id])
  appointments Appointment[]

  @@index([petId])
}

model Appointment {
  id                  String            @id @default(cuid())
  petId               String
  tutorId             String
  serviceId           String
  groomerId           String?
  recurringScheduleId String?

  source         AppointmentSource @default(MANUAL_STAFF)
  status         AppointmentStatus @default(PENDING_CONFIRMATION)
  scheduledStart DateTime
  scheduledEnd   DateTime
  estimatedEnd   DateTime? // recalculada por el Motor de Efecto en Cadena
  actualStart    DateTime?
  actualEnd      DateTime?

  quoteEstimated Decimal? @db.Decimal(10, 2)
  quoteFinal     Decimal? @db.Decimal(10, 2)
  cancelReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pet               Pet                @relation(fields: [petId], references: [id])
  tutor             Tutor              @relation(fields: [tutorId], references: [id])
  service           Service            @relation(fields: [serviceId], references: [id])
  groomer           Staff?             @relation(fields: [groomerId], references: [id])
  recurringSchedule RecurringSchedule? @relation(fields: [recurringScheduleId], references: [id])

  timeLogs       TimeLog[]
  notifications  NotificationLog[]
  formulaUsages  FormulaUsage[]
  instrumentUsages InstrumentUsageLog[]
  invoice        Invoice?
  prepItems      DailyPrepItem[]

  @@index([petId])
  @@index([tutorId])
  @@index([groomerId])
  @@index([scheduledStart])
  @@index([status])
}

// Notificaciones WhatsApp multietapa (T-5d, T-24h, T-22h, T-15min, recibo)
model NotificationLog {
  id            String             @id @default(cuid())
  appointmentId String?
  tutorId       String
  stage         NotificationStage
  status        NotificationStatus @default(QUEUED)
  scheduledFor  DateTime
  sentAt        DateTime?
  providerMessageId String? // sid de Twilio/Meta
  responsePayload   Json?
  createdAt     DateTime           @default(now())

  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  tutor       Tutor        @relation(fields: [tutorId], references: [id])

  @@index([appointmentId])
  @@index([tutorId])
  @@index([status, scheduledFor])
}

// ----------------------------------------------------------------------------
// MÓDULO 3: MISE EN PLACE AI (fórmulas + preparación diaria)
// ----------------------------------------------------------------------------

// Receta cosmética: producto + dilución
model Formula {
  id            String   @id @default(cuid())
  serviceId     String?
  productId     String
  name          String // ej. "Shampoo hipoalergénico 1:8"
  dilutionRatio String? // "1:8"
  instructions  String?

  service Service? @relation(fields: [serviceId], references: [id])
  product Product  @relation(fields: [productId], references: [id])
  usages  FormulaUsage[]

  @@index([productId])
}

// Bitácora real de uso de fórmula por cita (alimenta descuento de inventario)
model FormulaUsage {
  id            String   @id @default(cuid())
  appointmentId String
  formulaId     String
  mlUsed        Decimal  @db.Decimal(8, 2)
  notes         String?
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  formula     Formula     @relation(fields: [formulaId], references: [id])

  @@index([appointmentId])
  @@index([formulaId])
}

// Corrida diaria del algoritmo (20:00 hrs día anterior)
model DailyPrepPlan {
  id          String   @id @default(cuid())
  forDate     DateTime // día para el que se prepara
  generatedAt DateTime @default(now())

  items DailyPrepItem[]

  @@unique([forDate])
}

model DailyPrepItem {
  id                String       @id @default(cuid())
  planId            String
  appointmentId     String?
  type              PrepItemType
  productId         String? // si type = FORMULA
  instrumentId      String? // si type = INSTRUMENT
  description       String // ej. "Happy Hoodie talla M"
  quantityNeeded    Decimal      @db.Decimal(8, 2)
  stockAvailable    Decimal      @db.Decimal(8, 2)
  stockAlert        Boolean      @default(false)

  plan        DailyPrepPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  appointment Appointment?  @relation(fields: [appointmentId], references: [id])
  product     Product?      @relation(fields: [productId], references: [id])
  instrument  Instrument?   @relation(fields: [instrumentId], references: [id])

  @@index([planId])
}

// ----------------------------------------------------------------------------
// MÓDULO 4: MONITOR DE TIEMPOS EN MESA (comandos de voz + semáforo)
// ----------------------------------------------------------------------------

model TimeLog {
  id            String           @id @default(cuid())
  appointmentId String
  groomerId     String?
  stageType     ServiceStageType
  orderIndex    Int // posición en la secuencia (soporta reordenar)

  standardDurationMin Int
  overrideDurationMin Int? // Override manual en caliente

  startedAt DateTime?
  endedAt   DateTime?

  status       TimeLogStatus @default(ON_TRACK) // semáforo verde/amarillo/rojo
  delaySeconds Int           @default(0) // contador de exceso en tiempo real

  source TimeLogSource @default(MANUAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  groomer     Staff?      @relation(fields: [groomerId], references: [id])

  @@index([appointmentId])
  @@index([status])
}

// ----------------------------------------------------------------------------
// MÓDULO 5: INVENTARIO DE CONSUMIBLES Y MANTENIMIENTO DE ACTIVOS
// ----------------------------------------------------------------------------

model Product {
  id           String      @id @default(cuid())
  name         String
  unit         ProductUnit @default(ML)
  stockCurrent Decimal     @db.Decimal(10, 2)
  stockMin     Decimal     @db.Decimal(10, 2)
  costPerUnit  Decimal     @db.Decimal(10, 4)
  supplier     String?
  active       Boolean     @default(true)

  formulas     Formula[]
  transactions InventoryTransaction[]
  prepItems    DailyPrepItem[]
}

model InventoryTransaction {
  id                  String          @id @default(cuid())
  productId           String
  type                InventoryTxType
  quantity            Decimal         @db.Decimal(10, 2) // negativo en consumo si se prefiere signo
  relatedAppointmentId String?
  note                String?
  createdAt           DateTime        @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([relatedAppointmentId])
}

// Cuchillas, peines guía, tijeras, rastrillos — vida útil por horas/usos
model Instrument {
  id                  String           @id @default(cuid())
  name                String
  type                InstrumentType
  purchaseDate        DateTime
  expectedLifeHours   Decimal?         @db.Decimal(8, 2)
  expectedLifeUses    Int?
  usedHours           Decimal          @default(0) @db.Decimal(8, 2)
  usedCount           Int              @default(0)
  status              InstrumentStatus @default(OK)
  lastMaintenanceAt   DateTime?

  usageLogs InstrumentUsageLog[]
  prepItems DailyPrepItem[]
}

model InstrumentUsageLog {
  id            String   @id @default(cuid())
  instrumentId  String
  appointmentId String?
  minutesUsed   Decimal? @db.Decimal(6, 2)
  loggedAt      DateTime @default(now())

  instrument  Instrument   @relation(fields: [instrumentId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([instrumentId])
}

// Equipos mecánicos (turbinas, secadores, máquinas) — activos fijos con depreciación
model Equipment {
  id                 String          @id @default(cuid())
  name               String
  type               EquipmentType
  purchaseDate       DateTime
  purchaseCost       Decimal         @db.Decimal(10, 2)
  usefulLifeMonths   Int
  status             EquipmentStatus @default(OPERATIONAL)
  lastMaintenanceAt  DateTime?
  nextMaintenanceDue DateTime?

  maintenanceLogs MaintenanceLog[]
}

model MaintenanceLog {
  id            String   @id @default(cuid())
  equipmentId   String
  performedAt   DateTime @default(now())
  description   String
  cost          Decimal? @db.Decimal(10, 2)
  performedById String?
  nextDueAt     DateTime?

  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  performedBy Staff?    @relation(fields: [performedById], references: [id])

  @@index([equipmentId])
}

// ----------------------------------------------------------------------------
// MÓDULO 6: CIERRE, COBRO DIGITAL Y ANTI-MOROSIDAD
// ----------------------------------------------------------------------------

model Invoice {
  id            String        @id @default(cuid())
  appointmentId String        @unique
  tutorId       String

  subtotal Decimal @db.Decimal(10, 2)
  discount Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  finishedPhotoUrl String? // foto del trabajo terminado enviada por WhatsApp
  status           BillingStatus @default(PENDING_PROOF)
  paymentMethod    PaymentMethod?
  paidAt           DateTime?

  proofUrl           String? // comprobante subido por el cliente
  proofVerifiedAt    DateTime?
  proofVerifiedBy    String?
  manuallyUnblockedAt DateTime? // desautorización manual por admin
  manuallyUnblockedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointment Appointment   @relation(fields: [appointmentId], references: [id])
  tutor       Tutor         @relation(fields: [tutorId], references: [id])
  items       InvoiceItem[]

  @@index([tutorId])
  @@index([status])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int     @default(1)
  amount      Decimal @db.Decimal(10, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// ----------------------------------------------------------------------------
// MÓDULO 7: INTELIGENCIA FINANCIERA
// ----------------------------------------------------------------------------

model FixedExpense {
  id            String           @id @default(cuid())
  name          String
  category      String // renta, nómina, servicios, software, etc.
  amount        Decimal          @db.Decimal(10, 2)
  frequency     ExpenseFrequency @default(MONTHLY)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  active        Boolean          @default(true)
}

// Cache mensual opcional para acelerar el Panel Ejecutivo (se puede recalcular on-demand)
model FinancialSnapshot {
  id                  String   @id @default(cuid())
  month               DateTime // primer día del mes
  totalRevenue        Decimal  @db.Decimal(12, 2)
  totalFixedExpenses  Decimal  @db.Decimal(12, 2)
  totalSuppliesCost   Decimal  @db.Decimal(12, 2)
  totalDepreciation   Decimal  @db.Decimal(12, 2)
  netProfit           Decimal  @db.Decimal(12, 2)
  generatedAt         DateTime @default(now())

  @@unique([month])
}
