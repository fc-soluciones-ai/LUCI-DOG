# Postgres (Supabase) — Project Settings → Database → Connect
# Pooler en modo transacción (6543): usado por la app en runtime (Next.js/serverless)
DATABASE_URL="postgresql://postgres.umzwqtefveqgcejyruyh:[YOUR-PASSWORD]@aws-0-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Pooler en modo sesión (5432): usado solo por Prisma Migrate/seed
DIRECT_URL="postgresql://postgres.umzwqtefveqgcejyruyh:[YOUR-PASSWORD]@aws-0-us-east-2.pooler.supabase.com:5432/postgres"

# WhatsApp (Twilio) — opcional en desarrollo: sin estas variables,
# las notificaciones solo se imprimen en consola (ConsoleWhatsAppProvider).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""

# Datos de pago mostrados en el recibo de WhatsApp al cerrar un servicio (Módulo 6)
PAYMENT_INFO_TEXT="Transferencia CLABE 000000000000000000 (Banco Demo) o efectivo en el salón."

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Realtime (Dashboard TV) — Project Settings → API → Publishable key
NEXT_PUBLIC_SUPABASE_URL="https://umzwqtefveqgcejyruyh.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."

# Solo servidor — NUNCA exponer al navegador. Project Settings → API → Secret key.
# Usada para crear cuentas de staff (Supabase Admin API).
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Cuenta de solo lectura restringida para el Dashboard TV — créala en Supabase
# Auth y ponle este mismo email/password aquí. Se autentica sola en el
# servidor; la Smart TV nunca necesita hacer login interactivo.
TV_DISPLAY_EMAIL="tv-display@luci-dog.local"
TV_DISPLAY_PASSWORD=""
